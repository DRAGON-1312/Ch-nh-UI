# 🌏 PROVIDER CONFIG

# --- GEMINI API ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- TrackAsia API ---
TRACKASIA_TOKEN=
TRACKASIA_BASE_URL=https://maps.track-asia.com
TRACKASIA_QPS=1
TRACKASIA_MAX_RETRIES=3

# --- SerpAPI (thay thế Foursquare Places) ---
# Tạo API key tại: https://serpapi.com/manage-api-key
SERPAPI_KEY=

# ⚙️ NETWORK & BACKOFF

# Timeout mặc định cho mỗi HTTP request (giây)
HTTP_TIMEOUT_S=30

# Số lần retry khi lỗi network
RETRY_COUNT=3

# Thời gian chờ giữa các lần retry (giây, exponential backoff)
RETRY_BACKOFF_S=0.5

# 🚦 RATE LIMIT (Token Bucket)

# Giới hạn request mỗi giây cho từng provider
QPS_TRACKASIA=5
QPS_SERPAPI=5


# 💾 CACHE CONFIG

# Thời gian cache (giây)
CACHE_TTL_S=300


# 🧾 LOGGING

# Mức log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
