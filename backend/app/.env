# ⚙️ NETWORK & BACKOFF

# Timeout mặc định cho mỗi HTTP request (giây)
HTTP_TIMEOUT_S=30

# Số lần retry khi lỗi network
RETRY_COUNT=3

# Thời gian chờ giữa các lần retry (giây, exponential backoff)
RETRY_BACKOFF_S=0.5

# 🚦 RATE LIMIT (Token Bucket)

# Giới hạn request mỗi giây cho từng provider
QPS_TRACKASIA=5
QPS_SERPAPI=5


# 💾 CACHE CONFIG

# Thời gian cache (giây)
